<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core" >
   <Dialog
        title ="{configModel>/headerText}"
        class="sapUiResponsivePadding--content sapUiResponsivePadding--header sapUiResponsivePadding--footer sapUiResponsivePadding--subHeader">
        <content>
            <core:Fragment fragmentName="project1.view.fragments.ProductDataChangingDialogContent"/>
        </content>
        <footer>
			<Toolbar>
				<content>
                    <ToolbarSpacer />
                    <Button
                        text="{configModel>/buttonSubmitText}"
                        press=".onSubmitV4Product"
                        />
                    <Button
                        text="{i18n>dialogCancelButtonText}"
                        press=".onCancelProductV4DataChanging"
                        />
				</content>
			</Toolbar>
		</footer>
   </Dialog>
</core:FragmentDefinition>